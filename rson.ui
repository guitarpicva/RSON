              <item row="0" column="1">
               <widget class="QLineEdit" name="freqPrefixALineEdit">
                <property name="maxLength">
                 <number>16</number>
                </property>
                <property name="placeholderText">
                 <string>i.e. for ICOM IC-705 FEFEA4E005 or for FT-450D FA, etc.</string>
                </property>
               </widget>
              </item>
              <item row="1" column="0">
               <widget class="QLabel" name="label_13">
                <property name="text">
                 <string>Command Prefix VFO B</string>
                </property>
               </widget>
              </item>
              <item row="1" column="1">
               <widget class="QLineEdit" name="freqPrefixBLineEdit">
                <property name="placeholderText">
                 <string>Set VFO B freq for radios which can set freq independently. (else blank)</string>
                </property>
               </widget>
              </item>
              <item row="2" column="0">
               <widget class="QLabel" name="label_5">
                <property name="text">
                 <string>Number of FrequencyDigits</string>
                </property>
               </widget>
              </item>
              <item row="2" column="1">
               <widget class="QSpinBox" name="freqDigitsSpinBox">
                <property name="sizePolicy">
                 <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
                  <horstretch>0</horstretch>
                  <verstretch>0</verstretch>
                 </sizepolicy>
                </property>
                <property name="toolTip">
                 <string>Number of digits in the command sent to the radio which represent the frequency.  Typically 8 or 10, but sometimes more.</string>
                </property>
                <property name="minimum">
                 <number>8</number>
                </property>
                <property name="maximum">
                 <number>16</number>
                </property>
                <property name="value">
                 <number>10</number>
                </property>
